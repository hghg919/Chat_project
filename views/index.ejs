<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= appTitle %></title>

  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="background"></div>

  <div class="app">
    <section id="loginBox" class="login-card">
      <div class="logo">💬</div>

      <h1><%= appTitle %></h1>
      <p>회원가입 또는 로그인 후 채팅방에 입장하세요.</p>

      <div class="auth-tabs">
        <button type="button" id="showLoginBtn" class="tab-btn active">로그인</button>
        <button type="button" id="showRegisterBtn" class="tab-btn">회원가입</button>
      </div>

      <div id="authMessage" class="auth-message"></div>

      <div id="loginForm" class="auth-form">
        <input
          type="text"
          id="loginUsername"
          placeholder="아이디"
          autocomplete="off"
        />

        <input
          type="password"
          id="loginPassword"
          placeholder="비밀번호"
        />

        <button type="button" id="loginBtn">로그인</button>
      </div>

      <div id="registerForm" class="auth-form hidden">
        <input
          type="text"
          id="registerUsername"
          placeholder="아이디"
          autocomplete="off"
        />

        <input
          type="text"
          id="registerNickname"
          placeholder="닉네임"
          autocomplete="off"
          maxlength="12"
        />

        <input
          type="password"
          id="registerPassword"
          placeholder="비밀번호"
        />

        <input
          type="password"
          id="registerPasswordCheck"
          placeholder="비밀번호 확인"
        />

        <button type="button" id="registerBtn">회원가입</button>
      </div>
    </section>

    <section id="chatBox" class="chat-layout hidden">
      <aside class="side-panel">
        <div class="room-section">
          <h3>내 대화방</h3>

          <div id="roomList" class="room-list"></div>

          <div class="create-room-box">
            <input
              type="text"
              id="newRoomName"
              placeholder="새 대화방 이름"
              maxlength="20"
            />

            <button type="button" id="createRoomBtn">방 만들기</button>
          </div>

          <div class="invite-box">
            <input
              type="text"
              id="inviteUsername"
              placeholder="초대할 아이디"
            />

            <button type="button" id="inviteBtn">초대</button>
          </div>

          <p id="roomMessage" class="room-message"></p>
        </div>

        <div class="user-section">
          <h3>접속자</h3>
          <p><span id="userCount">0</span>명 접속 중</p>

          <ul id="userList" class="user-list"></ul>
        </div>

        <div class="member-section">
          <h3>대화방 멤버</h3>
          <ul id="memberList" class="member-list">
            <li class="empty-member">대화방을 선택하세요.</li>
          </ul>
        </div>
      </aside>

      <main class="chat-card">
        <header class="chat-header">
          <div>
            <h2 id="currentRoomTitle">대화방을 선택하세요</h2>
            <span id="adminBadge" class="admin-badge hidden">관리자 모드</span>
          </div>

          <div class="header-actions">
            <span class="live-badge">LIVE</span>
            <button type="button" id="logoutBtn" class="logout-btn">로그아웃</button>
          </div>
        </header>

        <ul id="messages" class="messages"></ul>

        <div id="typingText" class="typing-text"></div>

        <form id="chatForm" class="chat-form">
          <div class="emoji-area">
            <button type="button" id="emojiBtn" class="emoji-btn">😊</button>

            <div id="emojiPicker" class="emoji-picker hidden">
              <button type="button">😀</button>
              <button type="button">😂</button>
              <button type="button">😍</button>
              <button type="button">😎</button>
              <button type="button">😭</button>
              <button type="button">😡</button>
              <button type="button">👍</button>
              <button type="button">👏</button>
              <button type="button">❤️</button>
              <button type="button">🔥</button>
              <button type="button">🎉</button>
              <button type="button">💯</button>
            </div>
          </div>

          <div class="file-area">
            <button type="button" id="fileBtn" class="file-btn">📎</button>

            <input
              type="file"
              id="mediaInput"
              class="media-input"
              accept="image/*,video/*"
            />
          </div>

          <input
            type="text"
            id="messageInput"
            placeholder="대화방을 선택한 후 메시지를 입력하세요"
            autocomplete="off"
            maxlength="200"
          />

          <button type="submit" class="send-btn">전송</button>
        </form>
      </main>
    </section>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/client.js"></script>
</body>
</html>